# ===== Discord Bot =====
DISCORD_BOT_TOKEN= your_bot_token
# Discord channel ID used to notify employees when a transaction is successful.
STAFF_CHANNEL_ID= your_staff_channel_id

# ===== MoMo Business (Get in https://business.momo.vn) =====
PARTNER_CODE= your_partner_code
ACCESS_KEY= your_access_key
SECRET_KEY= your_secretkey

# Endpoint MoMo Production API: https://payment.momo.vn/v2/gateway/api/create
# Endpoint MoMo Test API: https://test-payment.momo.vn/v2/gateway/api/create
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api #Test API 

# ===== Callback URLs (HTTPS Is Required) =====
ipnUrl= your_ipn_url
redirectUrl= your_redirect_url
